# Read a single SDO object by index and sub-index.
# size: number of bytes to read — 1 (u8), 2 (u16), 4 (u32/s32). Default 4.

string name       # motor name
uint16 index      # OD object index (e.g. 0x6072)
uint8  sub_index  # OD sub-index (e.g. 0x01 for 2070h:01h)
uint8  size       # 1, 2, or 4 bytes (0 = default 4)
---
bool    success
string  message
int64   value     # raw value (caller interprets sign/scale)
