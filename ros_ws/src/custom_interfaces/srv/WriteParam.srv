# Write a single SDO object by index and sub-index.
# size: number of bytes to write — 1 (u8), 2 (u16), 4 (u32/s32). Default 4.
# The write is volatile (lost on power-off) unless persist=true.

string  name       # motor name ("all" for broadcast)
uint16  index      # OD object index (e.g. 0x6081)
uint8   sub_index  # OD sub-index (e.g. 0x01 for 2070h:01h)
uint8   size       # 1, 2, or 4 bytes (0 = default 4)
int64   value      # raw value to write
bool    persist    # if true, call save_params() after writing
---
bool   success
string message
